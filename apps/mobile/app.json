{
  "expo": {
    "name": "Смарт сүт",
    "slug": "smart-sut",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GPS нужен, чтобы фиксировать точку опроса молока в поле."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/DoubleSCorporation"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GPS нужен, чтобы фиксировать точку опроса молока в поле."
        }
      ]
    ]
  }
}
